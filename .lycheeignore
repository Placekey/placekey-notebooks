# Demo / localhost URLs that appear in tutorial cells.
^https?://localhost(:\d+)?/?

# Notebook-extraction artifacts: lychee treats embedded "\n" escapes as part
# of the URL, producing strings like "docs.placekey.io//n".
//n$

# Known-broken upstream links in pre-existing tutorial content. Leaving these
# to be fixed in a follow-up content-focused PR rather than widening the scope
# of the security/CI hardening change.
^https://dev\.placekey\.io/default/register$
^https://docs\.placekey\.io/Placekey_Technical_White_Paper\.pdf$
^https://shapely\.readthedocs\.io/en/latest/project\.html$

# Google Workspace Marketplace returns HTTP 400 to every non-browser client on
# /marketplace/app/* -- verified against a known-live third-party listing and a
# fabricated id, which both return 400, so the status says nothing about whether
# a listing exists. Valid in-browser; last confirmed 200 by an Internet Archive
# capture dated 2026-05-15.
^https://workspace\.google\.com/marketplace/app/

# LinkedIn answers every automated client with HTTP 999, its anti-bot status.
# It carries no information about whether a profile exists.
^https://(www\.)?linkedin\.com/
